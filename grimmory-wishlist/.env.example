# Copy to .env and fill in. Never commit .env.

# Notifications go to Chrome: open the Wishlist tab as the admin and click "Turn on" under
# Notifications, in each browser that should get them. Nothing to fill in for that.
#
# Optional: a long random password that lets your own scripts on this machine (a backup job,
# for example) send notifications through here too. Make one with:  openssl rand -hex 24
# Leave empty to keep that door shut.
NOTIFY_KEY=
# The one Grimmory user who gets the admin notifications (sign-ins, requests, library news,
# script alerts) (your own username). Empty: every admin. Everyone else only gets
# "your book is now in the library" for their own requests.
NOTIFY_OWNER=

# Tell the owner when someone signs in to Grimmory (off by default):
NOTIFY_ON_LOGIN=false

# Optional: also send everything to an ntfy topic (leave NTFY_TOPIC empty for Chrome only).
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
# One alert per person per this many minutes (avoids spam when tokens refresh):
NOTIFY_LOGIN_WINDOW_MIN=10
# Also alert when someone opens Grimmory with a saved session (off by default):
NOTIFY_ON_VISIT=false

# Book search as people type. Sources are asked together and merged, duplicates removed.
# Hardcover (best for series; needs a free token from https://hardcover.app/account/api):
HARDCOVER_TOKEN=
# Google Books and Open Library need no key. Google works without one; if it ever answers
# "too many requests", add a free key from Google Cloud (Books API) here:
GOOGLE_BOOKS_KEY=
# Which sources to use (comma separated): hardcover, google, openlibrary
SEARCH_SOURCES=hardcover,google,openlibrary

# Notify the admin when someone else asks for a book. Set your public address
# so clicking the notification opens the wishlist, e.g. https://books.example.com
NOTIFY_ON_WISHLIST=true
PUBLIC_URL=
# A Grimmory account of the wishlist's own, so books that reach the library are noticed (and
# requesters emailed) even when nobody has Grimmory open. Create a normal user in Grimmory with
# access to every library; it needs no admin rights. Leave empty to check only during visits.
GRIMMORY_WATCH_USER=
GRIMMORY_WATCH_PASSWORD=
# How often it checks, in minutes:
LIBRARY_CHECK_MIN=15
# How long "now in the library" entries stay on the page before clearing themselves:
KEEP_AVAILABLE_DAYS=30

# Email the requester when their book (or whole series) reaches the library. Leave SMTP_HOST empty
# to skip. For Gmail: smtp.gmail.com, port 587, your address as the user, and an "app password"
# (Google account > Security > App passwords), never your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Shown as the sender; defaults to SMTP_USER
SMTP_FROM=
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls

# Optional: watch an OverDrive library (Libby) for wishlist books and tell the owner when one
# arrives there or becomes free to borrow. Use your library's OverDrive address, for example
# https://yourlibrary.overdrive.com, and the name to show. Leave LIBRARY_URL empty to switch off.
LIBRARY_URL=
LIBRARY_NAME=
